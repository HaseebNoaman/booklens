# Secrets — never commit. .env.example is the template that ships.
.env

# The live database. bookfinder.seed.db IS tracked: it is the 250-book
# catalogue the app ships with, and it contains no user data.
bookfinder.db
*.db-journal
*.db-wal

# Build output and dependencies — regenerated by the Docker build.
# frontend/dist IS committed on purpose.
#
# A host that builds only Python -- Render, Railway, a plain VPS -- clones this
# repo and never runs pnpm, so without the built bundle in git it would serve an
# empty page. The Dockerfile ignores this copy and rebuilds the frontend itself
# (see .dockerignore), so the two paths do not fight.
#
# The cost: it can go stale. Run `pnpm run build` in frontend/ before pushing
# any frontend change.
frontend/node_modules/
node_modules/

# Runtime scratch
uploads/
data/cache/
__pycache__/
*.pyc
.pytest_cache/


# The database backup taken before the catalogue was curated. Local safety
# net, not something to ship -- it holds real user rows.
bookfinder.before-curation.db
