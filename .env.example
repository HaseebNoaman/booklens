# Copy this file to ".env" and fill in the values.
# The real .env is gitignored so secrets never end up in the repository.

# Use "development" locally. In production, BookLens refuses to start when
# SECRET_KEY or ADMIN_PASSWORD is missing instead of silently creating them.
BOOKLENS_ENV=development

# Signs the JWT login tokens. Leave empty — the app generates a strong
# random one on first start and saves it here automatically.
SECRET_KEY=

# Get a key at https://console.cloud.google.com (Books API).
# Optional locally: Open Library remains available when this is empty.
# Recommended in production so Tier 2 can compare both providers.
GOOGLE_BOOKS_API_KEY=

# Password for the built-in admin account (admin@bookai.com). Leave empty —
# the app generates a strong random one on first start and saves it here.
ADMIN_PASSWORD=

# Set to 1 ONLY while developing. Debug mode must stay off in production.
FLASK_DEBUG=0

# Set to 1 for a DEMO with no network. Every Google Books / Open Library
# lookup is then served from data/cache/ and no connection is ever opened; a
# cache miss fails loudly naming the missing key rather than quietly returning
# a worse answer. Pre-warm the cache first:
#     python test_covers/prewarm_demo_cache.py
DEMO_OFFLINE=0

# Which network interface the API listens on. The default (127.0.0.1) accepts
# connections from this machine only, so nothing is exposed unless you ask for
# it. Set to 0.0.0.0 to let a PHONE on the same wifi scan covers — the CORS
# allowlist already permits private-LAN origins on port 8080.
HOST=127.0.0.1

# Allow phone testing on a private LAN during development only. Production
# ignores private-LAN CORS origins even if this remains enabled.
ALLOW_PRIVATE_LAN=1

# SQLite location. Leave as the default for a local FYP deployment.
BOOKLENS_DB_PATH=bookfinder.db

# Security and resource limits.
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=24000000
JWT_EXPIRY_HOURS=24

# Set to 1 only when HTTPS is terminated by your trusted reverse proxy. This
# enables the Strict-Transport-Security response header.
BOOKLENS_HTTPS=0

# Trust X-Forwarded-For only behind a proxy you configure and control.
TRUST_PROXY=0

# Comma-separated exact frontend origins. Localhost:8080 is allowed for local
# development; private-LAN origins require ALLOW_PRIVATE_LAN=1.
ALLOWED_ORIGINS=

# Optional absolute temporary-upload directory. Files are deleted after each
# scan; when omitted, the project's uploads/ folder is used.
UPLOAD_FOLDER=

# Keep at zero in normal use. Temporary images are deleted after processing.
KEEP_UPLOADS_FOR_DEBUG=0

# ----- Outbound email (verification + password reset) -----
# Leave MAIL_PROVIDER empty in development: mailer.py then writes the full
# link to the server log instead of sending, so the whole flow is testable
# without an account anywhere.
#
# In production use an HTTPS-API provider, NOT smtp. Free hosts commonly block
# outbound SMTP ports (25/465/587), and smtplib does not fail fast when they
# do -- it hangs until the socket times out, turning a signup into a 30-second
# wait that fails anyway. Port 443 is never blocked.
#   resend | brevo | smtp
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=BookLens <onboarding@resend.dev>

# The origin the emailed links point at. Must be the public URL once deployed,
# or every confirmation link will point at the developer's laptop.
APP_BASE_URL=http://127.0.0.1:5000

# Only needed when MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
